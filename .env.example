# Required. Supabase Postgres connection string.
# Use the pooled URI from Supabase when running remotely.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional. Defaults to stdio for local MCP clients.
# For hosted deployments, use a transport supported by your mcp package version,
# such as sse or streamable-http.
MCP_TRANSPORT=streamable-http
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://crowdcode.app,https://www.crowdcode.app

# Browser/API endpoints.
CROWDCODE_MCP_URL=http://127.0.0.1:8000/mcp
CROWDCODE_REQUESTS_TABLE=service_requests
# Aggregate "requested, not yet built" ideas at most once per day.
PROJECT_IDEAS_CACHE_SECONDS=86400

# OpenAI summarization for the "requested, not yet built" section.
# Leave the key unset to fall back to keyword clustering (no LLM call).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Optional. Used to hash v1 reviewer IDs from payment references.
CROWDCODE_REVIEWER_SALT=change-me-for-shared-environments

# Wallet-keyed service-request limit (rolling 24h window; 0 disables).
CROWDCODE_REQUEST_LIMIT_PER_DAY=5

# Token pinning for on-chain payment verification (docs/SCORING.md §3.4).
# Required for mppx reviews. Without it, verification fails closed with a
# retryable payment_verifier_misconfigured response and stores nothing.
MPPX_TEMPO_TOKEN_ADDRESS=0x20C000000000000000000000b9537d11c60E8b50
# x402 on Base defaults to native USDC; override only for testing.
# X402_USDC_ADDRESS=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
# Optional RPC overrides.
# X402_BASE_RPC_URL=https://mainnet.base.org
# MPPX_TEMPO_RPC_URL=https://rpc.tempo.xyz
